/**
 * КАПЕР ДЖАРВИС — порядок в листах таблицы «КАПЕР ДЖАРВИС КХЛ».
 *
 * Как запустить (один раз):
 *   1. Откройте таблицу. На всякий случай: Файл → Создать копию.
 *   2. Расширения → Apps Script → «+» → Скрипт, назовите файл tidy_sheets
 *      и вставьте в него весь этот текст.
 *   3. Вверху выберите функцию tidySheets → «Выполнить».
 *   4. Вернитесь во вкладку таблицы — там появится вопрос про удаление.
 *
 * Что делает:
 *   - спрашивает, удалить ли устаревшие листы из списка SHEETS_TO_DELETE
 *     (ответ «Нет» — ничего не удаляется, остальные шаги всё равно выполнятся);
 *   - ставит видимые листы группами по порядку и красит ярлыки по группам;
 *   - красит скрытые листы в серый, не открывая их.
 *
 * Формулы и скрипты обращаются к листам по названию, поэтому перестановка
 * и цвет ярлыков ничего не ломают. Названия листов не меняются.
 */

// Устаревшие листы: на них не ссылается ни одна формула, и их никто не
// обновляет (проверено по выгрузке таблицы 30.09.2026).
const SHEETS_TO_DELETE = [
  'Контекст и новости',       // старый разведчик с GitHub, последняя запись 14.09, только ошибки
  'Статистика_debug',         // ошибка 403 от QuantHockey — источник больше не используется
  'Диагностика_результатов',  // разовая отладка разбора sports.ru (26.09)
  'Диагностика_новостей',     // разовая отладка новостей
  'Диагностика_составов',     // разовая отладка составов (27.09)
];

// Видимые листы по группам — в таком порядке они встанут слева направо.
// Листы, которых нет в списке, останутся после групп как есть.
const SHEET_GROUPS = [
  { name: 'Главное на каждый день', color: '#34a853', sheets: [
    'Прогнозы — кратко', 'Купон дня', 'Коэффициенты', 'Модель vs рынок',
    'Таблица', 'Карточка команды', 'Угадай победителей',
  ]},
  { name: 'Разведка', color: '#4285f4', sheets: [
    'Факты', 'Агент_сводки', 'Досье_команд', 'Ключевые_игроки', 'Статистика_КХЛ',
  ]},
  { name: 'Итоги и проверка', color: '#fbbc04', sheets: [
    'Точность', 'Банкролл', 'Агент_проверка', 'Elo_история', 'Посты',
  ]},
  { name: 'Настройки (правите вы)', color: '#ff6d01', sheets: [
    'Мои поправки', 'Эмодзи_клубов', 'Справочник команд', 'Каналы_экспертов',
    'Видео_эксперты', 'Расклад_экспертов', 'Автоматика',
  ]},
  { name: 'Модель (формулы, не трогать)', color: '#9e9e9e', sheets: [
    'прогнозы', 'результаты матчей',
  ]},
];

const HIDDEN_SHEETS_COLOR = '#d9d9d9';

function tidySheets() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const ui = SpreadsheetApp.getUi();
  const report = [];

  // 1. Удаление устаревших листов — только после подтверждения.
  const toDelete = SHEETS_TO_DELETE.filter(name => ss.getSheetByName(name));
  if (toDelete.length) {
    const answer = ui.alert(
      'Удалить устаревшие листы?',
      toDelete.join('\n') + '\n\nНа них не ссылается ни одна формула. «Нет» — ничего не удалять.',
      ui.ButtonSet.YES_NO);
    if (answer === ui.Button.YES) {
      toDelete.forEach(name => ss.deleteSheet(ss.getSheetByName(name)));
      report.push('Удалено листов: ' + toDelete.length);
    } else {
      report.push('Удаление пропущено');
    }
  }

  // 2. Видимые листы — по группам и с цветом ярлыка. Скрытые не двигаем:
  //    чтобы переставить лист, его нужно сделать активным, а это его открывает.
  let position = 1;
  const missing = [];
  SHEET_GROUPS.forEach(group => {
    group.sheets.forEach(name => {
      const sheet = ss.getSheetByName(name);
      if (!sheet) { missing.push(name); return; }
      sheet.setTabColor(group.color);
      if (sheet.isSheetHidden()) return;
      ss.setActiveSheet(sheet);
      ss.moveActiveSheet(position++);
    });
  });
  report.push('Расставлено по группам: ' + (position - 1));

  // 3. Скрытые листы — серым, чтобы сразу было видно, что они служебные.
  let hidden = 0;
  ss.getSheets().forEach(sheet => {
    if (sheet.isSheetHidden()) { sheet.setTabColor(HIDDEN_SHEETS_COLOR); hidden++; }
  });
  report.push('Скрытых (покрашены в серый): ' + hidden);
  if (missing.length) report.push('Не найдены: ' + missing.join(', '));

  ss.setActiveSheet(ss.getSheets()[0]);
  ui.alert('Готово', report.join('\n'), ui.ButtonSet.OK);
}
